# Base URL of the PettyCash.Api backend.
VITE_API_BASE_URL=http://localhost:5080

# Authentication mode.
# false — bypass MSAL; use the dev auth provider (DevelopmentAuthenticationHandler on the backend).
#          No Entra tenant, no login prompt. Safe for local development only.
# true  — (or omit) full MSAL flow; requires VITE_ENTRA_* values below to be real.
VITE_AUTH_ENABLED=false

# Microsoft Entra (Azure AD) app registration. Required only when VITE_AUTH_ENABLED=true.
VITE_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
VITE_ENTRA_TENANT_ID=your-tenant-id-or-common
VITE_ENTRA_REDIRECT_URI=http://localhost:5173
VITE_ENTRA_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/signin
VITE_ENTRA_SCOPES=api://petty-cash-api/access_as_user

# Dev-auth-only (VITE_AUTH_ENABLED=false). Ignored when VITE_AUTH_ENABLED=true.
# VITE_DEV_USERNAME — username the dev provider presents to the backend.
#   Must match an AppUserProfile.AppUserId row in the backend seed data.
#   Default (if omitted): spender.demo
# VITE_DEV_ROLE     — role of the dev user: "Spender" or "Approver".
#   Set to "Approver" to unlock manager-only routes locally without Entra.
#   Default (if omitted): Spender
VITE_DEV_USERNAME=spender.demo
VITE_DEV_ROLE=Spender

