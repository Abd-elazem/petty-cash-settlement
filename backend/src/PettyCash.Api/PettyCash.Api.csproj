<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>PettyCash.Api</RootNamespace>
    <!--
      Scoped to this new project only, not solution-wide (no Directory.Build.props change) —
      Domain/Application/Infrastructure just passed a fully verified, frozen build; retroactively
      enabling this there risks breaking that approved state on a warning I can't see or fix
      myself (no local build access). Applying it here, on fresh code I write carefully, is the
      safe way to honor "keep WarningsAsErrors enabled" without gambling with already-approved work.
    -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!--
    References ONLY Application and Infrastructure — never Domain directly, per Sprint 5's
    explicit rule. This isn't just a convention: Application returns DTOs (SettlementDto etc.),
    never Domain entities, specifically so nothing above Application ever needs a Domain type.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Asp.Versioning.Http" />
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PettyCash.Application\PettyCash.Application.csproj" />
    <ProjectReference Include="..\PettyCash.Infrastructure\PettyCash.Infrastructure.csproj" />
  </ItemGroup>

</Project>
