{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "PettyCashDev": "Host=localhost;Port=5432;Database=pettycash_dev;Username=postgres;Password=postgres"
  },
  "PettyCash": {
    "VatRatePercent": 14
  },
  "Authentication": {
    "Entra": {
      "Enabled": false,
      "TenantId": "",
      "ClientId": "",
      "RequireHttpsMetadata": true,
      "Claims": {
        "RoleClaimType": "roles",
        "UserIdClaimTypes": [ "oid", "sub", "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/nameidentifier" ],
        "EmailClaimTypes": [ "preferred_username", "upn", "email", "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress" ]
      }
    }
  },
  "AllowedHosts": "*"
}
